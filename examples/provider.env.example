# Ejemplo de configuración del adaptador OpenAI-compatible.
# Copiar como .env.local (ignorado por Git) o exportar las variables en la
# sesión. No guardar claves reales en el repositorio.

# Obligatorias. Usar HTTPS; HTTP sin TLS solo se acepta en loopback.
AUTOSOLID_OPENAI_BASE_URL=https://<PROVEEDOR>/v1
AUTOSOLID_OPENAI_MODEL=<MODELO>

# Opcional. La clave solo se envía en la cabecera Authorization y no aparece
# en repr, errores, logs ni en to_public_dict().
AUTOSOLID_OPENAI_API_KEY=<API_KEY>

# Opcionales.
AUTOSOLID_OPENAI_ORGANIZATION=<ORGANIZACION>
AUTOSOLID_OPENAI_TIMEOUT_SECONDS=60
AUTOSOLID_OPENAI_MAX_RESPONSE_BYTES=4000000
AUTOSOLID_OPENAI_ALLOW_INSECURE_HTTP=false
AUTOSOLID_OPENAI_USE_SYSTEM_PROXY=false
