<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>autosolid-solidworks</AssemblyName>
    <RootNamespace>AutoSolid.SolidWorksAgent</RootNamespace>
    <SolidWorksRoot Condition="'$(SOLIDWORKS_ROOT)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SolidWorksRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksRoot)\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksRoot)\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
